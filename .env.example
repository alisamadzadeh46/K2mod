DJANGO_ADMIN_URL_PREFIX=

# comma separated
ENAMAD_CODES=

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# set to False to test with DEBUG=False over plain http (e.g. docker on localhost)
USE_HTTPS=True

# docker only
NGINX_PORT=80
GUNICORN_WORKERS=3
